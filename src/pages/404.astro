---
import Layout from "../layouts/BaseLayout.astro";

const currentPath = Astro.url.pathname;
const finalTerm = "";
---

<Layout title="404: Page Not Found">
    <main class="flex flex-col items-start gap-8 py-8 px-2 prose max-w-none">
        <p>
            Sorry, we couldn't find your exact page
            <code id="display-path">{currentPath}</code>.

            <div class="flex flex-col gap-4">
                <a
                    id="search-link"
                    href="/search/"
                    class="btn"
                >
                    Search here for <code id="display-search-term">{finalTerm}</code>
                </a>
                or
                <a href="/" class="btn secondary">go home</a>
            </div>
        </p>
    </main>
    <script is:inline>
          (function update404PageDetails() {
            /**
             * Extracts the last meaningful segment from the current URL path.
             */
            function getLastSegment(path) {
              return path.split('/').filter(Boolean).pop() ?? "";
            }

            //(pathname already strips away any hash part)
            const realPath = window.location.pathname;
            const term = getLastSegment(realPath);

            const displayPath = document.getElementById('display-path');
            const searchLink = document.getElementById('search-link');
            const searchTerm = document.getElementById('display-search-term');

            if (displayPath) {displayPath.textContent = realPath;}
            if (searchTerm) {searchTerm.textContent = term;}
            if (searchLink) {
                searchLink.href = `/search/?term=${encodeURIComponent(term)}`;
            }
          })();
        </script>
</Layout>
