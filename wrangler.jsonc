{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p5-js-website-deploy-test-tmp",
  "compatibility_date": "2026-03-12",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "beta": {
      "routes": [
      ]
    }
  }
}